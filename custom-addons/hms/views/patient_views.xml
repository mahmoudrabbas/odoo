<odoo>

    <record id="patient_list" model="ir.ui.view">
        <field name="name">patient.list</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="blood_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="patient_form" model="ir.ui.view">
        <field name="name">patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="birth_date"/>
                        <field name="age"/>
                    </group>

                    <group>
                        <field name="department_id"/>
                        <field name="department_capacity" readonly="1"/>
                        <field name="doctor_ids" widget="many2many_tags"
                               readonly="not department_id"/>
                    </group>

                    <group>
                        <field name="blood_type"/>
                        <field name="pcr"/>
                        <field name="cr_ratio" required="pcr"/>
                        <field name="state"/>
                    </group>

                    <group>
                        <field name="address"/>
                        <field name="image"/>
                    </group>

                    <group>
                        <field name="history" invisible="age &lt; 50"/>
                    </group>

                    <notebook>
                        <page string="Logs">
                            <field name="log_ids">
                                <list>
                                    <field name="created_by"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hms_root" name="HMS"/>

    <menuitem id="hms_patient_menu"
              name="Patients"
              parent="hms_root"
              action="patient_action"/>

    <menuitem id="department_menu"
              name="Departments"
              parent="hms_root"
              action="department_action"/>

    <menuitem id="doctor_menu"
              name="Doctors"
              parent="hms_root"
              action="doctor_action"/>

</odoo>
